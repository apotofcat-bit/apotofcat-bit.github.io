<%
    // 当前是否正在看某个标签的归档（网址 /tags/xxx/）
    let selected = null;
    site.tags.forEach((tag) => {
        if (is_tag(tag.name)) selected = tag;
    });

    const tags = site.tags.toArray();
    const maxCount = tags.reduce((max, tag) => Math.max(max, tag.posts.length), 0);

    const hueOf = (text) => {
        let hue = 0;
        for (let i = 0; i < text.length; i++) {
            hue = (hue * 31 + text.charCodeAt(i)) % 360;
        }
        return hue;
    };
%>
<div id="archives">
    <div class="taxonomy-cloud">
        <% if (tags.length === 0) { %>
        <div class="taxonomy-empty">
            还没有标签。在文章的 front-matter 里加上
            <code>tags: [Hexo, 主题]</code>，这里就会自动出现标签。
        </div>
        <% } %>
        <% tags.forEach((tag) => { %>
        <%
            // 文章越多字号越大：最少 12.5px，最多 21.5px
            const ratio = maxCount > 1 ? (tag.posts.length - 1) / (maxCount - 1) : 0;
            const size = (12.5 + ratio * 9).toFixed(1);
            const hue = hueOf(tag.name);
            const tagStyle = `font-size: ${size}px; background: hsla(${hue}, 62%, 72%, 0.18); color: hsl(${hue}, 45%, 42%);`;
        %>
        <a
            class="taxonomy-tag<%- selected && selected.name === tag.name ? " active" : "" %>"
            href="<%- url_for(tag.path) %>"
            style="<%- tagStyle %>"
        >
            #<%= tag.name %>
            <span class="taxonomy-count"><%= tag.posts.length %></span>
        </a>
        <% }); %>
    </div>
    <% if (!selected && tags.length > 0) { %>
    <div class="taxonomy-hint">点上面的标签，查看该标签下的文章</div>
    <% } %>
    <% if (selected) { %>
    <% const posts = selected.posts.toArray().sort((a, b) => b.date - a.date); %>
    <%- partial("timeline", { posts }) %>
    <% } %>
</div>
