<%
    // 当前是否正在看某个分类的归档（网址 /categories/xxx/）
    let selected = null;
    site.categories.forEach((category) => {
        if (is_category(category.name)) selected = category;
    });

    const categories = site.categories.toArray();

    // 颜色由名字哈希得到，同一个分类每次构建都是同一个颜色
    const hueOf = (text) => {
        let hue = 0;
        for (let i = 0; i < text.length; i++) {
            hue = (hue * 31 + text.charCodeAt(i)) % 360;
        }
        return hue;
    };
%>
<div id="archives">
    <div class="taxonomy-cards">
        <% if (categories.length === 0) { %>
        <div class="taxonomy-empty">
            还没有分类。在文章的 front-matter 里加上
            <code>categories: [随笔]</code>，这里就会自动出现分类卡片。
        </div>
        <% } %>
        <% categories.forEach((category) => { %>
        <%
            const hue = hueOf(category.name);
            const cardStyle = `background-image: linear-gradient(135deg, hsl(${hue}, 62%, 72%) 0%, hsl(${(hue + 45) % 360}, 62%, 80%) 100%);`;
        %>
        <a
            class="taxonomy-card<%- selected && selected.name === category.name ? " active" : "" %>"
            href="<%- url_for(category.path) %>"
            style="<%- cardStyle %>"
        >
            <span class="taxonomy-name">
                <span class="icon"><i class="fa-solid fa-bookmark fa-fw"></i></span>
                <%= category.name %>
            </span>
            <span class="taxonomy-count"><%= category.posts.length %> 篇</span>
        </a>
        <% }); %>
    </div>
    <% if (!selected && categories.length > 0) { %>
    <div class="taxonomy-hint">点上面的卡片，查看该分类下的文章</div>
    <% } %>
    <% if (selected) { %>
    <% const posts = selected.posts.toArray().sort((a, b) => b.date - a.date); %>
    <%- partial("timeline", { posts }) %>
    <% } %>
</div>
