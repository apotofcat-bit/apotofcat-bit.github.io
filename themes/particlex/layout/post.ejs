<%
    // 顶部背景图：优先用文章自己的 cover，否则从主题的 background 里按路径挑一张
    // （用路径做哈希而不是随机，保证每次构建挑到的是同一张）
    let bannerCover = page.cover || null;
    if (!bannerCover && theme.background && theme.background.length) {
        let index = 0;
        const seed = String(page.path || page.title || "");
        for (let i = 0; i < seed.length; i++) {
            index = (index * 31 + seed.charCodeAt(i)) % theme.background.length;
        }
        bannerCover = theme.background[index];
    }
    const bannerStyle = bannerCover ? ` style="background-image: url('${url_for(bannerCover)}')"` : "";

    // 目录：本地从二级标题开始，避免和文章标题重复；加密文章不生成目录（会泄露结构）
    const encrypted = theme.crypto.enable && typeof page.secret !== "undefined";
    const tocHtml = encrypted ? "" : toc(page.content, { list_number: false, min_depth: 2, max_depth: 4 });
    const hasToc = tocHtml.indexOf("<a ") !== -1;
%>
<div id="post-head"<%- bannerStyle %>>
    <div id="post-head-info">
        <h1 class="post-head-title"><%= page.title %></h1>
        <div class="post-head-meta">
            <span class="meta-item">
                <span class="icon"><i class="fa-regular fa-calendar fa-fw"></i></span>
                发布于 <%- date(page.date, "YYYY/M/D") %>
            </span>
            <span class="meta-item">
                <span class="icon"><i class="fa-solid fa-pen-nib fa-fw"></i></span>
                字数统计 <%- symbolsCount(page) %> 字
            </span>
            <span class="meta-item">
                <span class="icon"><i class="fa-regular fa-clock fa-fw"></i></span>
                阅读时长 <%- symbolsTime(page) %> 分钟
            </span>
        </div>
    </div>
</div>
<div id="post-wrap">
    <% if (hasToc) { %>
    <aside id="post-toc">
        <div id="toc-title">
            <i class="fa-solid fa-list-ul fa-fw"></i>目录
        </div>
        <div id="toc-body"><%- tocHtml %></div>
    </aside>
    <% } %>
    <div class="article">
        <div class="info">
            <% if (page.categories && page.categories.data.length !== 0) { %>
            <span class="category">
                <a href="<%- url_for(page.categories.data[0].path) %>">
                    <span class="icon">
                        <i class="fa-solid fa-bookmark fa-fw"></i>
                    </span>
                    <%= page.categories.data[0].name %>
                </a>
            </span>
            <% } %>
            <% if (page.tags && page.tags.data.length !== 0) { %>
            <span class="tags">
                <span class="icon">
                    <i class="fa-solid fa-tags fa-fw"></i>
                </span>
                <% let prev; %>
                <% page.tags.data.forEach((tag) => { %>
                <span class="tag">
                    <%
                        const colors = theme.colors.filter((color) => color !== prev);
                        let id = Math.floor(Math.random() * colors.length);
                        prev = colors[id];
                    %>
                    <a href="<%- url_for(tag.path) %>" style="color: <%- colors[id] %>">
                        <%= tag.name %>
                    </a>
                </span>
                <% }); %>
            </span>
            <% } %>
        </div>
        <% if (encrypted) { %>
        <% const CryptoJS = getCryptoJS(); %>
        <input
            id="crypto"
            :class="['input', cryptoStatus]"
            :disabled="cryptoStatus === 'success'"
            ref="crypto"
            placeholder="文章被加密，请输入密码"
            data-encrypted="<%- CryptoJS.AES.encrypt(page.content, page.secret).toString() %>"
            data-shasum="<%- CryptoJS.SHA256(page.content).toString() %>"
            v-model="crypto"
        />
        <transition name="fade">
            <div class="content" ref="content" v-show="cryptoStatus === 'success'"></div>
        </transition>
        <% } else { %>
        <div class="content" v-pre>
            <%- page.content %>
        </div>
        <% } %>
        <% if (page.comments) { %>
        <% if (theme.gitalk.enable) { %>
        <div id="comment">
            <div id="gitalk-container"></div>
        </div>
        <% } %>
        <% if (theme.giscus.enable) { %>
        <div id="comment">
            <div id="giscus-container" class="giscus"></div>
        </div>
        <% } %>
        <% if (theme.waline.enable) { %>
        <div id="comment">
            <div id="waline-container"></div>
        </div>
        <% } %>
        <% if (theme.twikoo.enable) { %>
        <div id="comment">
            <div id="twikoo-container"></div>
        </div>
        <% } %>
        <% } %>
    </div>
    <% if (theme.card.enable) { %>
    <!-- 复用首页那张名片：沿用 #home-card 这个 id，样式和响应式行为都和首页一致 -->
    <div id="home-card">
        <%- partial("card") %>
    </div>
    <% } %>
</div>
